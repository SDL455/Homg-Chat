rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection rules
    match /users/{userId} {
      // Allow users to read any user profile
      allow read: if isAuthenticated();
      
      // Allow users to create/update only their own profile
      allow create, update: if isOwner(userId);
      
      // Don't allow delete
      allow delete: if false;
    }
    
    // Chats collection rules
    match /chats/{chatId} {
      // Helper to check if user is a participant
      function isParticipant() {
        return isAuthenticated() && (
          // Check if user is in participants array
          (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
          // Or check if chatId contains user's ID (format: uid1_uid2)
          chatId.matches('.*' + request.auth.uid + '.*')
        );
      }
      
      function isParticipantCreate() {
        return isAuthenticated() && (
          // Check if user is in participants array for create operation
          (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
          // Or check if chatId contains user's ID
          chatId.matches('.*' + request.auth.uid + '.*')
        );
      }
      
      // Allow participants to read chats
      allow read: if isParticipant();
      
      // Allow authenticated users to create chats
      allow create: if isParticipantCreate();
      
      // Allow participants to update chats
      allow update: if isParticipant();
      
      // Don't allow delete
      allow delete: if false;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Allow participants of the parent chat to read/write messages
        allow read, write: if isAuthenticated();
      }
    }
  }
}

